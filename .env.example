# Groq's OpenAI-compatible API. Set GROQ_API_KEY in your local .env file.
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# PaddleOCR GPU device (install the CUDA-enabled PaddlePaddle build for your CUDA version).
OCR_ENGINE=paddleocr
PADDLEOCR_DEVICE=gpu:0
PADDLEOCR_LANG=en

# GPU preference for embedding and optional vision models.
REQUIRE_GPU=1

# Optional Qwen2-VL table recovery; leave disabled for the normal pipeline.
MULTIMODAL_ENABLED=0
MULTIMODAL_MODEL_NAME=Qwen/Qwen2-VL-2B-Instruct
MULTIMODAL_MODEL_PATH=
MULTIMODAL_LOCAL_ONLY=1
MULTIMODAL_USE_GPU=1
MULTIMODAL_MAX_NEW_TOKENS=768
MULTIMODAL_RENDER_SCALE=2.0
MULTIMODAL_RETRY_EMPTY_PAGES=1

LOG_LEVEL=INFO

# ── API / deployment (Half B) ─────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional Redis cache (leave empty to disable). Docker compose sets this.
REDIS_URL=
CACHE_TTL_SECONDS=604800

# Optional Qdrant server URL (e.g. http://localhost:6333). When unset, uses local ./qdrant_storage.
QDRANT_URL=

# Run manufacturer matching automatically after every extraction (0/1).
MATCH_AUTORUN=0
MANUFACTURERS_DIR=data/manufacturers
